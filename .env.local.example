# Credenciales del proyecto de Supabase (Project Settings > API)
# NO dejes https://placeholder.supabase.co ni tu-proyecto — Next arranca pero
# getReports/getCollectionPoints hacen "TypeError: fetch failed".
# Dashboard → Project Settings → API → Project URL + anon public.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública del sitio (usada para los links compartidos por WhatsApp)
NEXT_PUBLIC_SITE_URL=https://pereiraunida.com

# Ruta secreta para crear acopios en producción: /a/<este-valor>
# Ejemplo: https://pereiraunida.com/a/cambia-este-pin
# Si defines ACOPIO_SECRET, esa es la ruta y ACOPIO_PIN queda como respaldo.
# Si quitas ambas, la ruta responde 404 y el alta queda cerrada.
ACOPIO_PIN=cambia-este-pin
# ACOPIO_SECRET=slug-largo-dificil-de-adivinar

# Opcional, SOLO server (nunca usar prefijo NEXT_PUBLIC_). Si se define,
# createCollectionPoint inserta usando la service role (bypassa RLS de
# forma controlada) en vez de la anon key; en ese caso puedes cerrar la
# policy "collection_points_insert_public" (ver schema.sql / migración).
# Si la dejas vacía, el alta sigue funcionando con la anon key y el PIN es
# la única barrera real.
# SUPABASE_SERVICE_ROLE_KEY=

# DigitalOcean Spaces (fotos). SOLO server, nunca NEXT_PUBLIC_.
# Endpoint de la región + CDN del bucket. Las fotos se sirven por el CDN.
SPACES_KEY=tu-access-key
SPACES_SECRET=tu-secret-key
SPACES_BUCKET=testing-pt
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
SPACES_CDN_URL=https://testing-pt.sfo3.cdn.digitaloceanspaces.com
