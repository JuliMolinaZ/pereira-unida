# Credenciales del proyecto de Supabase (Project Settings > API)
# NO dejes https://placeholder.supabase.co ni tu-proyecto — Next arranca pero
# getReports/getCollectionPoints hacen "TypeError: fetch failed".
# Dashboard → Project Settings → API → Project URL + anon public.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública del sitio (usada para los links compartidos por WhatsApp)
NEXT_PUBLIC_SITE_URL=https://pereiraunida.com

# Ruta secreta para crear acopios en producción: /a/<este-valor>
# Ejemplo: https://pereiraunida.com/a/cambia-este-pin
# Si defines ACOPIO_SECRET, esa es la ruta y ACOPIO_PIN queda como respaldo.
# Si quitas ambas, la ruta responde 404 y el alta queda cerrada.
ACOPIO_PIN=cambia-este-pin
# ACOPIO_SECRET=slug-largo-dificil-de-adivinar

# SOLO server (nunca usar prefijo NEXT_PUBLIC_). Requerida desde que se
# cerró el acceso público directo a la base (ver "Notas de seguridad" en el
# README): todas las escrituras y la tabla people_status (red familiar)
# dependen de esta key. Sin ella, "Estoy bien" deja de funcionar por
# completo y las demás escrituras vuelven a depender solo de la anon key.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# API pública de solo lectura (/api/public/v1/ayudas, /ayudantes) para que
# otras apps consuman datos. Sin esta key, esos endpoints responden 503
# (deshabilitados). Documentación interactiva en /docs/api.
# PUBLIC_API_KEY=genera-una-key-larga-y-aleatoria

# Fuentes externas sincronizadas (Ayudas Pereira, Corag, Pereira Responde),
# ver lib/externalSync.ts. La sincronización real la dispara el propio
# tráfico de la app (sin costo, sin Cron); esta key solo protege el disparo
# manual en /api/cron/sync-external, útil para probar o para engancharlo a
# un cron externo si algún día hace falta más frecuencia.
# CRON_SECRET=genera-otra-key-larga-y-aleatoria

# Notificaciones push (nueva solicitud/oferta/arriendo cerca), Web Push
# estándar con VAPID — sin servicio de terceros. Generá el par con
# `npx web-push generate-vapid-keys`. La pública es segura de exponer al
# navegador (por eso el prefijo); la privada nunca.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-correo@dominio.com

# DigitalOcean Spaces (fotos). SOLO server, nunca NEXT_PUBLIC_.
# Endpoint de la región + CDN del bucket. Las fotos se sirven por el CDN.
SPACES_KEY=tu-access-key
SPACES_SECRET=tu-secret-key
SPACES_BUCKET=testing-pt
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
SPACES_CDN_URL=https://testing-pt.sfo3.cdn.digitaloceanspaces.com
