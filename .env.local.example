# Credenciales del proyecto de Supabase (Project Settings > API)
# NO dejes https://placeholder.supabase.co ni tu-proyecto — Next arranca pero
# getReports/getCollectionPoints hacen "TypeError: fetch failed".
# Dashboard → Project Settings → API → Project URL + anon public.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública del sitio (usada para los links compartidos por WhatsApp)
NEXT_PUBLIC_SITE_URL=https://pereiraunida.vercel.app

# PIN compartido para habilitar el alta de nuevos puntos de acopio desde la
# app (sin login: lo valida createCollectionPoint en el server, en tiempo
# constante). Si esta variable NO está definida, el formulario de alta de
# acopio no se muestra y la acción retorna error. Cámbialo en producción.
ACOPIO_PIN=cambia-este-pin

# Opcional, SOLO server (nunca usar prefijo NEXT_PUBLIC_). Si se define,
# createCollectionPoint inserta usando la service role (bypassa RLS de
# forma controlada) en vez de la anon key; en ese caso puedes cerrar la
# policy "collection_points_insert_public" (ver schema.sql / migración).
# Si la dejas vacía, el alta sigue funcionando con la anon key y el PIN es
# la única barrera real.
# SUPABASE_SERVICE_ROLE_KEY=
